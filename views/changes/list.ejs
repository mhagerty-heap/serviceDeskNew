<%- include('../partials/head', { title: 'Changes' }) %>
<%- include('../partials/nav') %>
<main>
  <section class="sd-portal-header">
    <div class="sd-portal-header-inner">
      <h1>Changes</h1>
      <p>Planned changes with a documented risk level and schedule.</p>
    </div>
  </section>
  <section class="sd-portal-body">
    <div class="sd-portal-body-inner">
      <%- include('../partials/flash') %>
      <% if (isAgent) { %>
        <div class="sd-portal-actions">
          <a href="/changes/new" class="btn btn-sd-primary"><i class="bi bi-plus-lg"></i> New change</a>
        </div>
      <% } %>
      <div class="sd-table-wrap">
        <table class="sd-table">
          <thead><tr><th>Title</th><th>Status</th><th>Risk</th><th>Scheduled</th></tr></thead>
          <tbody>
            <% changes.forEach(function(c) { %>
              <tr onclick="window.location='/changes/<%= c.id %>'">
                <td><%= c.title %></td>
                <td><span class="sd-mock-pill sd-pill-<%= c.status %>"><%= c.status %></span></td>
                <td><span class="sd-mock-pill sd-pill-<%= c.risk_level %>"><%= c.risk_level %></span></td>
                <td><%= c.scheduled_at || '&mdash;' %></td>
              </tr>
            <% }) %>
            <% if (changes.length === 0) { %><tr><td colspan="4" class="sd-table-empty">No changes scheduled.</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
