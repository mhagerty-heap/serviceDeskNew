<%- include('../partials/head', { title: 'New Change' }) %>
<%- include('../partials/nav') %>
<main>
  <section class="sd-portal-header">
    <div class="sd-portal-header-inner"><h1>New change</h1></div>
  </section>
  <section class="sd-portal-body">
    <div class="sd-portal-body-inner sd-narrow">
      <%- include('../partials/flash') %>
      <form method="POST" action="/changes" class="sd-form">
        <div class="sd-form-row">
          <label for="title">Title</label>
          <input type="text" id="title" name="title" required>
        </div>
        <div class="sd-form-row">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="4" required></textarea>
        </div>
        <div class="sd-form-row-group">
          <div class="sd-form-row">
            <label for="risk_level">Risk level</label>
            <select id="risk_level" name="risk_level">
              <option value="low">Low</option>
              <option value="medium">Medium</option>
              <option value="high">High</option>
            </select>
          </div>
          <div class="sd-form-row">
            <label for="scheduled_at">Scheduled for</label>
            <input type="datetime-local" id="scheduled_at" name="scheduled_at">
          </div>
        </div>
        <button type="submit" class="btn btn-sd-primary btn-lg w-100">Create change</button>
      </form>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
