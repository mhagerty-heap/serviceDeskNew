<%- include('../partials/head', { title: change.title }) %>
<%- include('../partials/nav') %>
<main>
  <section class="sd-portal-header">
    <div class="sd-portal-header-inner">
      <h1>#<%= change.id %> &mdash; <%= change.title %></h1>
      <div class="sd-ticket-meta">
        <span class="sd-mock-pill sd-pill-<%= change.status %>"><%= change.status %></span>
        <span class="sd-mock-pill sd-pill-<%= change.risk_level %>">Risk: <%= change.risk_level %></span>
      </div>
    </div>
  </section>
  <section class="sd-portal-body">
    <div class="sd-portal-body-inner">
      <%- include('../partials/flash') %>
      <div class="sd-ticket-description">
        <h3>Description</h3>
        <p><%= change.description %></p>
        <span class="sd-ticket-submeta">Scheduled for <%= change.scheduled_at || 'not yet scheduled' %></span>
      </div>
      <% if (isAgent) { %>
        <form method="POST" action="/changes/<%= change.id %>/update" class="sd-form sd-narrow">
          <div class="sd-form-row">
            <label for="status">Status</label>
            <select id="status" name="status">
              <% ['planning','scheduled','completed','rolled_back'].forEach(function(s) { %>
                <option value="<%= s %>" <%= change.status === s ? 'selected' : '' %>><%= s %></option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn btn-sd-primary">Save changes</button>
        </form>
      <% } %>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
