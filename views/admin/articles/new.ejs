<%- include('../../partials/admin-head', { title: 'New Article' }) %>
<%- include('../sidebar', { activePage: 'articles' }) %>
  <div class="sd-admin-topbar"><h1>New article</h1></div>
  <div class="sd-admin-content">
    <%- include('../../partials/flash') %>
    <form id="form-new-article" method="POST" action="/admin/articles" class="sd-form sd-narrow">
      <div class="sd-form-row">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" required>
      </div>
      <div class="sd-form-row">
        <label for="category">Category</label>
        <input type="text" id="category" name="category" placeholder="e.g. Account, Billing, IT">
      </div>
      <div class="sd-form-row">
        <label for="body">Body</label>
        <textarea id="body" name="body" rows="8" required></textarea>
      </div>
      <button id="btn-publish-article" type="submit" class="btn btn-sd-primary">Publish article</button>
    </form>
  </div>
<%- include('../../partials/admin-scripts') %>
