<%- include('../../partials/admin-head', { title: 'New Agent' }) %>
<%- include('../sidebar', { activePage: 'agents' }) %>
  <div class="sd-admin-topbar"><h1>New agent</h1></div>
  <div class="sd-admin-content">
    <%- include('../../partials/flash') %>
    <form id="form-new-agent" method="POST" action="/admin/agents" class="sd-form sd-narrow">
      <div class="sd-form-row">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required>
      </div>
      <div class="sd-form-row">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="sd-form-row">
        <label for="password">Temporary password</label>
        <input type="password" id="password" name="password" required minlength="6">
      </div>
      <div class="sd-form-row">
        <label for="role">Role</label>
        <select id="role" name="role">
          <option value="agent">Agent</option>
          <option value="admin">Admin</option>
        </select>
      </div>
      <button id="btn-create-agent" type="submit" class="btn btn-sd-primary">Create agent</button>
    </form>
  </div>
<%- include('../../partials/admin-scripts') %>
