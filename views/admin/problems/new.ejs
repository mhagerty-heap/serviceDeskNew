<%- include('../../partials/admin-head', { title: 'New Problem' }) %>
<%- include('../sidebar', { activePage: 'problems' }) %>
  <div class="sd-admin-topbar"><h1>New problem</h1></div>
  <div class="sd-admin-content">
    <%- include('../../partials/flash') %>
    <form id="form-new-problem" method="POST" action="/admin/problems" class="sd-form sd-narrow">
      <div class="sd-form-row">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" required>
      </div>
      <div class="sd-form-row">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="5" required></textarea>
      </div>
      <button id="btn-create-problem" type="submit" class="btn btn-sd-primary btn-lg w-100">Create problem</button>
    </form>
  </div>
<%- include('../../partials/admin-scripts') %>
