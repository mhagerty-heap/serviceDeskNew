<%- include('../../partials/admin-head', { title: 'New Change' }) %>
<%- include('../sidebar', { activePage: 'changes' }) %>
  <div class="sd-admin-topbar"><h1>New change</h1></div>
  <div class="sd-admin-content">
    <%- include('../../partials/flash') %>
    <form id="form-new-change" method="POST" action="/admin/changes" class="sd-form sd-narrow">
      <div class="sd-form-row">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" required>
      </div>
      <div class="sd-form-row">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4" required></textarea>
      </div>
      <div class="sd-form-row-group">
        <div class="sd-form-row">
          <label for="risk_level">Risk level</label>
          <select id="risk_level" name="risk_level">
            <option value="low">Low</option>
            <option value="medium">Medium</option>
            <option value="high">High</option>
          </select>
        </div>
        <div class="sd-form-row">
          <label for="scheduled_at">Scheduled for</label>
          <input type="datetime-local" id="scheduled_at" name="scheduled_at">
        </div>
      </div>
      <button id="btn-create-change" type="submit" class="btn btn-sd-primary btn-lg w-100">Create change</button>
    </form>
  </div>
<%- include('../../partials/admin-scripts') %>
