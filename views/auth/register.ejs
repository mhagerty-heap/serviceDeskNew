<%- include('../partials/head', { title: 'Start free trial' }) %>
<%- include('../partials/nav') %>
<main>
  <section class="sd-auth">
    <div class="sd-auth-card">
      <h1>Start your free trial</h1>
      <%- include('../partials/flash') %>
      <form id="form-register" method="POST" action="/register" class="sd-form">
        <div class="sd-form-row">
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" required autofocus>
        </div>
        <div class="sd-form-row">
          <label for="email">Work email</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div class="sd-form-row">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required minlength="6">
        </div>
        <button id="btn-register-submit" type="submit" class="btn btn-sd-primary btn-lg w-100">Create account</button>
      </form>
      <p class="sd-auth-switch">Already have an account? <a id="auth-switch-login" href="/login">Log in</a></p>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
