<%- include('../partials/head', { title: 'Log in' }) %>
<%- include('../partials/nav') %>
<main>
  <section class="sd-auth">
    <div class="sd-auth-card">
      <h1>Log in to ServiceDesk</h1>
      <%- include('../partials/flash') %>
      <form id="form-login" method="POST" action="/login" class="sd-form">
        <div class="sd-form-row">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autofocus>
        </div>
        <div class="sd-form-row">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required>
        </div>
        <button id="btn-login-submit" type="submit" class="btn btn-sd-primary btn-lg w-100">Log in</button>
      </form>
      <p class="sd-auth-switch">Don't have an account? <a id="auth-switch-register" href="/register">Start a free trial</a></p>
      <div class="sd-auth-demo-hint">
        <strong>Demo logins</strong>
        <span>admin@servicedesk.io / password123 (admin)</span>
        <span>agent@servicedesk.io / password123 (agent)</span>
        <span>customer@servicedesk.io / password123 (customer)</span>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
