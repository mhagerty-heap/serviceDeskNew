<%- include('partials/head', { title: 'Request a Demo' }) %>
<%- include('partials/nav') %>
<main>
  <%- include('partials/flash') %>
  <section class="sd-page-header">
    <div class="sd-page-header-inner">
      <h1>Request a demo</h1>
      <p>Tell us a bit about your team and we'll walk you through ServiceDesk live.</p>
    </div>
  </section>

  <section class="sd-contact">
    <div class="sd-contact-inner">
      <form id="form-contact" method="POST" action="/contact" class="sd-form">
        <div class="sd-form-row">
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div class="sd-form-row">
          <label for="email">Work email</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div class="sd-form-row">
          <label for="company">Company</label>
          <input type="text" id="company" name="company">
        </div>
        <div class="sd-form-row">
          <label for="teamSize">Team size</label>
          <select id="teamSize" name="teamSize">
            <option>1&ndash;5 agents</option>
            <option>6&ndash;20 agents</option>
            <option>21&ndash;100 agents</option>
            <option>100+ agents</option>
          </select>
        </div>
        <div class="sd-form-row">
          <label for="message">What are you hoping to solve?</label>
          <textarea id="message" name="message" rows="4"></textarea>
        </div>
        <button id="btn-contact-submit" type="submit" class="btn btn-sd-primary btn-lg w-100">Request a demo</button>
      </form>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
