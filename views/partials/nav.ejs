<nav class="sd-nav">
  <div class="sd-nav-inner">
    <a id="nav-logo" class="sd-logo" href="/">
      <span class="sd-logo-mark"><i class="bi bi-life-preserver"></i></span>
      ServiceDesk
    </a>

    <div class="sd-nav-links">
      <a id="nav-link-features" href="/features">Features</a>
      <a id="nav-link-pricing" href="/pricing">Pricing</a>
      <a id="nav-link-kb" href="/kb">Knowledge Base</a>
      <a id="nav-link-about" href="/about">About</a>
      <a id="nav-link-contact" href="/contact">Contact</a>
    </div>

    <div class="sd-nav-actions">
      <%# AI assistant (scripted chat) — agent-widget.js unhides it and reads data-default-scenario %>
      <a id="ai-agent-icon-link" class="sd-nav-ai-icon" href="#" title="AI Assistant" style="display:none;"
         data-default-scenario="<%= typeof defaultAiScenarioSlug !== 'undefined' && defaultAiScenarioSlug ? defaultAiScenarioSlug : '' %>">
        <i class="bi bi-robot"></i>
      </a>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <a id="nav-ticket-count" class="sd-nav-ticket-count" href="/portal">
          <i class="bi bi-ticket-perforated"></i>
          <% if (openTicketCount > 0) { %><span class="sd-badge"><%= openTicketCount %></span><% } %>
        </a>
        <a id="nav-dashboard-link" class="btn btn-sd-outline" href="/portal">Dashboard</a>
        <a id="nav-logout-link" class="btn btn-sd-primary" href="/logout">Log out</a>
      <% } else { %>
        <a id="nav-login-link" class="btn btn-sd-outline" href="/login">Log in</a>
        <a id="nav-demo-link" class="btn btn-sd-primary" href="/contact">Request a demo</a>
      <% } %>
    </div>
  </div>
</nav>
