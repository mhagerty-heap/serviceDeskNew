<section id="section-ticketing" class="sd-feature">
  <div class="sd-feature-inner">
    <div class="sd-feature-copy">
      <span class="sd-eyebrow"><i class="bi bi-ticket-perforated"></i> Ticketing &amp; automation</span>
      <h2>Route, prioritize, and resolve &mdash; automatically.</h2>
      <p>
        Smart routing sends every ticket to the right agent based on department, workload,
        and skill. SLA timers and escalation rules run quietly in the background so nothing
        slips through.
      </p>
      <ul class="sd-feature-list">
        <li><i class="bi bi-check2-circle"></i> Rule-based auto-assignment</li>
        <li><i class="bi bi-check2-circle"></i> SLA timers with automatic escalation</li>
        <li><i class="bi bi-check2-circle"></i> Canned responses &amp; macros</li>
      </ul>
      <% if (typeof homeLinks !== "undefined" && homeLinks) { %><a id="section-link-ticketing" href="/features#ticketing" class="sd-learn-more">Learn more &rarr;</a><% } %>
    </div>
    <div class="sd-feature-visual">
      <div class="sd-mini-card">
        <div class="sd-mini-card-header"><i class="bi bi-lightning-charge-fill"></i> Automation rule</div>
        <div class="sd-mini-card-row">If <strong>priority = Urgent</strong></div>
        <div class="sd-mini-card-row">and <strong>department = IT</strong></div>
        <div class="sd-mini-card-row sd-mini-card-arrow"><i class="bi bi-arrow-return-right"></i> Assign to <strong>on-call agent</strong></div>
        <div class="sd-mini-card-row sd-mini-card-arrow"><i class="bi bi-arrow-return-right"></i> Notify via <strong>Slack</strong></div>
      </div>
    </div>
  </div>
</section>
