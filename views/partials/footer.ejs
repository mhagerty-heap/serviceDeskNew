<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
  (function () {
    var demo = new URLSearchParams(window.location.search).get('demo');
    if (!demo) return;

    function fireApiError(path, body) {
      fetch(path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body || {})
      }).then(function (r) {
        return r.json().then(function (data) {
          if (!r.ok) {
            var err = new Error(data.code + ': ' + data.message);
            console.error('[SD-DEMO] API error:', err.message);
            throw err;
          }
        });
      }).catch(function (e) {
        console.error('[SD-DEMO] API error:', e.message);
      });
    }

    setTimeout(function () {
      switch (demo) {
        case 'ticket-submit-error':
          fireApiError('/api/ticket-submit-error', { subject: 'demo_ticket' });
          break;
        case 'kb-search-error':
          fireApiError('/api/kb-search-error', { query: 'demo_search' });
          break;
        case 'sla-error':
          fireApiError('/api/sla-calculation-error', { ticket_id: 'demo_ticket' });
          break;
        case 'notification-error':
          fireApiError('/api/notification-error', { ticket_id: 'demo_ticket' });
          break;
        case 'js-ticket-error':
          throw new Error('TicketSubmitServiceUnavailable: upstream timeout after 30000ms');
        case 'js-notification-error':
          throw new Error('NotificationDispatcher: connection refused — please retry');
      }
    }, 1500);
  })();
</script>
</body>
</html>
