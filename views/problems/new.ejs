<%- include('../partials/head', { title: 'New Problem' }) %>
<%- include('../partials/nav') %>
<main>
  <section class="sd-portal-header">
    <div class="sd-portal-header-inner"><h1>New problem</h1></div>
  </section>
  <section class="sd-portal-body">
    <div class="sd-portal-body-inner sd-narrow">
      <%- include('../partials/flash') %>
      <form method="POST" action="/problems" class="sd-form">
        <div class="sd-form-row">
          <label for="title">Title</label>
          <input type="text" id="title" name="title" required>
        </div>
        <div class="sd-form-row">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn btn-sd-primary btn-lg w-100">Create problem</button>
      </form>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
