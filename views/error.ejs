<%- include('partials/head', { title: typeof title !== 'undefined' ? title : 'Error' }) %>
<%- include('partials/nav') %>
<main>
  <section class="sd-error">
    <div class="sd-error-inner">
      <div class="sd-error-code"><%= typeof status !== 'undefined' ? status : '' %></div>
      <h1><%= typeof title !== 'undefined' ? title : 'Something went wrong' %></h1>
      <p><%= typeof message !== 'undefined' ? message : 'Please try again.' %></p>
      <a id="btn-back-home" href="/" class="btn btn-sd-primary">Back to home</a>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
